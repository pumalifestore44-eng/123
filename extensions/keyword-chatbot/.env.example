# Copy to .env and fill values
MESSAGES_API_URL=https://your-app.example.com/api/conversations/latest
SEND_API_URL=https://your-app.example.com/api/messages/send
AUTH_HEADER=Bearer your_api_token_here
POLL_INTERVAL_MS=5000
KEYWORDS=trả hàng,huỷ,refund
RESPONSE_TEMPLATE=Xin chào! Đây là trả lời tự động. Chúng tôi đã nhận được tin nhắn của bạn.

# SMAX integration (preferred)
# If you provide SMAX_BIZ_ID and SMAX_TOKEN, the extension will query SMAX threads directly.
SMAX_BIZ_ID=tuant2lqd
SMAX_PAGE_IDS=fb1574281086218015,ig17841471719838606,ttw6622749003845042177,zlw266741166578791076
SMAX_TOKEN=Bearer xxxxxxxxxxxxx

# Alternatively, fetch SMAX token from Supabase (if you store it there)
SUPABASE_URL=https://<PROJECT>.supabase.co
SUPABASE_KEY=<service_role_key>
